        <mxCell id="seq-uc12-note-0" value="&lt;b&gt;Nhánh UC12 bị từ chối / request invalid:&lt;/b&gt; Controller gọi WriteAsync(false) rồi Forbid() / BadRequest(); KHÔNG bắt đầu transaction." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF6E7;strokeColor=#DBA65B;strokeWidth=1.5;fontColor=#23324A;fontSize=14;fontFamily=Arial;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="463" width="850" height="61" as="geometry"/>
        </mxCell>
        <mxCell id="seq-uc12-note-1" value="&lt;b&gt;Nhánh policy từ chối:&lt;/b&gt; Không gọi ApplyAsync (mũi tên ApplyAsync chỉ thuộc nhánh allowed). Controller vẫn thêm UserAccessLog(false) và commit. Nếu lỗi, transaction rollback." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF6E7;strokeColor=#DBA65B;strokeWidth=1.5;fontColor=#23324A;fontSize=14;fontFamily=Arial;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="962" y="1068" width="820" height="75" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

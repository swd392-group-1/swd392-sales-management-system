classDiagram
    direction TB

    class Book {
        <<catalog entity>>
        +string Id
        +string Title
    }

    class BookStock {
        <<stock source>>
        +string BookId
        +decimal CurrentQuantity
    }

    class InventoryCount {
        <<aggregate root>>
        +string Id
        +DateTime CountedAtUtc
        +string RecordedByEmployeeId
        +bool IsFinalized
        +List~InventoryCountObservation~ Observations
        +List~InventoryCountSelection~ Selections
        +AddObservation(bookId, countedQuantity, observedAtUtc)
        +Finalize(selectionIds, referenceQty) CountFinalization
    }

    class InventoryCountObservation {
        <<entity - count history>>
        +long Id
        +string BookId
        +decimal CountedQuantity
        +DateTime ObservedAtUtc
    }

    class InventoryCountSelection {
        <<entity - finalized result>>
        +string BookId
        +long SelectedObservationId
        +decimal RecordedQuantity
    }

    class CountFinalization {
        <<value object>>
        +IReadOnlyList~FinalizedCountLine~ Lines
        +bool HasDifference
    }

    class FinalizedCountLine {
        <<value object>>
        +string BookId
        +long ObservationId
        +decimal ReferenceQuantity
        +decimal CountedQuantity
        +decimal Difference
    }

    class InventoryAdjustment {
        <<aggregate root>>
        +string Id
        +DateOnly AdjustmentDate
        +string Reason
        +CreateForCount(countId, adjustmentId, at, lines) InventoryAdjustment
    }

    class AdjustmentBook {
        <<entity - difference lines only>>
        +string BookId
        +decimal QuantityChange
    }

    class CountAdjustment {
        <<link 1-1 count-adjustment>>
        +string CountId
        +string AdjustmentId
    }

    class InventoryMovement {
        <<ledger entry>>
        +long Id
        +string PostingKey
        +string BookId
        +decimal QuantityDelta
        +CreateForAdjustment(adjustmentId, book, at) InventoryMovement
    }

    class InventoryAudit {
        <<aggregate root - INDEPENDENT>>
        +string Id
        +string Status
        +bool IsApproved
        +AddLine(bookId, countedQuantity)
        +Approve()
    }

    class InventoryAuditLine {
        <<entity>>
        +long Id
        +string BookId
        +decimal CountedQuantity
    }

    InventoryCount "1" *-- "0..*" InventoryCountObservation : stores count history
    InventoryCount "1" *-- "0..*" InventoryCountSelection : finalized selection
    InventoryCountSelection "0..*" ..> "1" InventoryCountObservation : selected_observation_id
    InventoryCount ..> CountFinalization
    CountFinalization "1" *-- "1..*" FinalizedCountLine
    InventoryAdjustment "1" *-- "0..*" AdjustmentBook
    CountAdjustment "1" -- "1" InventoryCount
    CountAdjustment "1" -- "1" InventoryAdjustment
    InventoryAudit "1" *-- "1..*" InventoryAuditLine
    InventoryCount "0..*" --> "1" Book : BookId
    InventoryAuditLine "0..*" --> "1" Book : BookId
    InventoryMovement "0..*" --> "1" BookStock : same BookId

    note for InventoryAudit "Approve() only sets Status = APPROVED.\nNo relation to InventoryAdjustment,\nInventoryMovement, or BookStock."
    note for InventoryCountSelection "recorded_quantity = ledger quantity\nsnapshot taken at finalize time."

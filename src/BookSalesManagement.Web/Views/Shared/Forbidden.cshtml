@using BookSalesManagement.Application.Abstractions
@{
    ViewData["Title"] = "Không có quyền truy cập";
    var permissionId = ViewData["PermissionId"] as string ?? "—";
    var permissionName = ViewData["PermissionName"] as string ?? "—";
    var currentUser = ViewData["CurrentUser"] as ICurrentUser;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4 p-lg-5">
                <div class="badge-soft badge-warn mb-3">HTTP 403 · Forbidden</div>
                <h1 class="page-title mb-2">Tài khoản không có quyền truy cập</h1>
                <p class="page-lead mb-4">
                    Yêu cầu đã bị chặn ở server theo quyền của tài khoản đang đăng nhập.
                    Đây là kiểm tra phía server, không phụ thuộc vào việc ẩn nút trên giao diện.
                </p>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="metric-card">
                            <div class="metric-label">Quyền yêu cầu</div>
                            <div class="metric-value fs-6 mono mt-2">@permissionId</div>
                            <div class="metric-note">@permissionName</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="metric-card">
                            <div class="metric-label">Tài khoản hiện tại</div>
                            <div class="metric-value fs-6 mt-2">@(currentUser?.DisplayName ?? "Chưa đăng nhập")</div>
                            <div class="metric-note mono">@(currentUser?.EmployeeId ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary px-3" asp-controller="Session" asp-action="Index">Đổi tài khoản demo</a>
                    <a class="btn btn-outline-secondary px-3" asp-controller="Home" asp-action="Index">Về tổng quan</a>
                </div>
            </div>
        </div>
    </div>
</div>

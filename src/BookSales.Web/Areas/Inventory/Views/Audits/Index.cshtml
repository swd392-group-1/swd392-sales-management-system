@model IReadOnlyList<InventoryAuditSummary>
@{
    ViewData["Title"] = "Audit tồn kho";
    var pending = Model.Count(a => !string.Equals(a.Status, "APPROVED", StringComparison.OrdinalIgnoreCase));
}

<div class="page-head">
    <div>
        <h1 class="page-title">Đợt audit tồn kho</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary px-3" asp-controller="Counts" asp-action="Index">Phiếu kiểm kê</a>
        <a class="btn btn-primary px-3" asp-action="Create">Tạo đợt audit</a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Danh sách đợt audit</span>
        <span class="small-muted">@Model.Count đợt · @pending chờ duyệt</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">Chưa có đợt audit nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app">
                <thead>
                    <tr>
                        <th>Đợt audit</th>
                        <th>Ngày audit</th>
                        <th class="text-end">Số dòng</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var audit in Model)
                {
                    <tr>
                        <td class="mono">@audit.Id</td>
                        <td>@(audit.AuditDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="text-end">@audit.LineCount</td>
                        <td>
                            @if (string.Equals(audit.Status, "APPROVED", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge-soft badge-done">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-open">Chờ duyệt</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@audit.Id">Mở</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@model AuditDetailsViewModel
@{
    ViewData["Title"] = $"Audit {Model.Audit.Id}";
    var audit = Model.Audit;
    var isApproved = audit.IsApproved || string.Equals(audit.Status, "APPROVED", StringComparison.OrdinalIgnoreCase);
}

<div class="page-head">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <h1 class="page-title mono">@audit.Id</h1>
        @if (isApproved)
        {
            <span class="badge-soft badge-done">Đã duyệt</span>
        }
        else
        {
            <span class="badge-soft badge-open">Chờ duyệt</span>
        }
    </div>
    <a class="btn btn-outline-secondary px-3" asp-action="Index">Danh sách audit</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-4">
        <div class="metric-card">
            <div class="metric-label">Ngày audit</div>
            <div class="metric-value fs-5">@(audit.AuditDate?.ToString("dd/MM/yyyy") ?? "—")</div>
        </div>
    </div>
    <div class="col-6 col-xl-4">
        <div class="metric-card">
            <div class="metric-label">Số dòng</div>
            <div class="metric-value">@audit.Lines.Count</div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="metric-card">
            <div class="metric-label">Trạng thái</div>
            <div class="metric-value fs-5 mono">@audit.Status</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>Kết quả kiểm tra</span>
        <span class="small-muted">Tồn hiện tại chỉ để tham khảo</span>
    </div>
    @if (audit.Lines.Count == 0)
    {
        <div class="empty-state">Đợt audit chưa có dòng nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app">
                <thead>
                    <tr>
                        <th>Sách</th>
                        <th class="text-end">Số lượng audit</th>
                        <th class="text-end">Tồn hiện tại</th>
                        <th class="text-end">Chênh lệch</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in audit.Lines)
                {
                    var delta = line.CountedQuantity - line.CurrentQuantity;
                    <tr>
                        <td>
                            <div class="fw-semibold">@line.BookTitle</div>
                            <div class="mono text-secondary">@line.BookId</div>
                        </td>
                        <td class="text-end fw-bold">@line.CountedQuantity.ToString("0.##")</td>
                        <td class="text-end text-secondary">@line.CurrentQuantity.ToString("0.##")</td>
                        <td class="text-end">
                            @if (delta == 0)
                            {
                                <span class="diff-zero">0</span>
                            }
                            else
                            {
                                <span class="@(delta > 0 ? "diff-positive" : "diff-negative")">@delta.ToString("+0.##;-0.##;0")</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card mt-4">
    <div class="card-header">Duyệt audit</div>
    <div class="card-body">
        @if (isApproved)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="badge-soft badge-done">APPROVED</span>
                <span class="small-muted">Đã xác nhận kết quả · không thay đổi tồn kho.</span>
            </div>
        }
        else if (Model.CanApprove)
        {
            <form method="post" asp-action="Approve" asp-route-id="@audit.Id"
                  onsubmit="return confirm('Duyệt audit chỉ xác nhận kết quả, không đổi tồn kho. Tiếp tục?');">
                <button type="submit" class="btn btn-dark px-4">Duyệt audit</button>
            </form>
        }
        else
        {
            <span class="small-muted">Tài khoản hiện tại không có quyền duyệt audit.</span>
        }
    </div>
</div>

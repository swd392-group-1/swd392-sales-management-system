@using BookSalesManagement.Web.Services.Abstractions
@{
    ViewData["Title"] = "Không có quyền truy cập";
    var permissionId = ViewData["PermissionId"] as string ?? "—";
    var permissionName = ViewData["PermissionName"] as string ?? "—";
    var currentUser = ViewData["CurrentUser"] as ICurrentUser;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-4 p-lg-5 text-center">
                <div class="badge-soft badge-warn mb-3">HTTP 403</div>
                <h1 class="page-title mb-2">Không có quyền truy cập</h1>
                <p class="page-lead mb-4">Tài khoản đang đăng nhập không được phép mở màn hình này.</p>

                <div class="row g-3 mb-4 text-start">
                    <div class="col-md-6">
                        <div class="metric-card">
                            <div class="metric-label">Quyền yêu cầu</div>
                            <div class="metric-value fs-6 mono mt-2">@permissionId</div>
                            <div class="metric-note">@permissionName</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="metric-card">
                            <div class="metric-label">Tài khoản hiện tại</div>
                            <div class="metric-value fs-6 mt-2">@(currentUser?.DisplayName ?? "Chưa đăng nhập")</div>
                            <div class="metric-note mono">@(currentUser?.EmployeeId ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a class="btn btn-primary px-3" asp-controller="Session" asp-action="Index">Đổi tài khoản</a>
                    <a class="btn btn-outline-secondary px-3" asp-controller="Home" asp-action="Index">Về tổng quan</a>
                </div>
            </div>
        </div>
    </div>
</div>

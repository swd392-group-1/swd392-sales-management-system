@using System.Globalization
@model BookReturnSearchViewModel

@{
    ViewData["Title"] = "Tìm đơn hàng trả sách";
}

<section class="page-heading">
    <h1>Tìm đơn hàng trả sách</h1>
    <p class="intro">Tìm đơn bán gốc để kiểm tra các dòng sách còn đủ điều kiện trả.</p>
</section>

<nav class="return-module-nav" aria-label="Điều hướng khu vực trả sách">
    <a class="return-module-nav-link" asp-controller="Returns" asp-action="Search" asp-route-orderId="@Model.OrderId" aria-current="page">Tìm đơn hàng</a>
    <a class="return-module-nav-link" asp-controller="Returns" asp-action="History" asp-route-orderId="@Model.Order?.OrderId">Lịch sử trả sách</a>
</nav>

<section class="panel return-panel">
    <form method="get" asp-controller="Returns" asp-action="Search" class="return-search-form">
        <label for="orderId">Mã đơn hàng</label>
        <div class="return-search-controls">
            <input id="orderId" name="orderId" value="@Model.OrderId" maxlength="200" autocomplete="off" />
            <button type="submit" class="button">Tìm đơn</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <p class="return-error" role="alert">@Model.Error</p>
    }
</section>

@if (Model.Order is { } order)
{
    var paymentMethodLabel = order.PaymentMethod switch
    {
        "Cash" => "Tiền mặt",
        "QR" => "QR",
        _ => "Không rõ"
    };
    var paymentStatusLabel = order.PaymentStatus switch
    {
        "Completed" => "Đã thanh toán",
        "Pending" => "Đang chờ thanh toán",
        "Failed" => "Thanh toán thất bại",
        _ => "Không rõ"
    };

    <section class="panel return-panel">
        <div class="section-heading">
            <h2>Đơn hàng @order.OrderId</h2>
        </div>
        <dl class="return-order-meta">
            <div><dt>Ngày bán</dt><dd>@(order.OrderDate?.ToString("dd/MM/yyyy") ?? "Không có")</dd></div>
            <div><dt>Thanh toán</dt><dd>@paymentMethodLabel · @paymentStatusLabel</dd></div>
            <div><dt>Tổng đơn</dt><dd>@(order.TotalOrderAmount?.ToString("N4", CultureInfo.GetCultureInfo("vi-VN")) ?? "Không có") đ</dd></div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(order.IneligibilityMessage))
        {
            <p class="return-notice">@order.IneligibilityMessage</p>
        }

        <div class="sale-table-wrap">
            <table class="sale-table return-table">
                <thead>
                    <tr>
                        <th>Mã sách</th>
                        <th>Tên sách</th>
                        <th class="sale-number-column">Đã mua</th>
                        <th class="sale-number-column">Đã trả</th>
                        <th class="sale-number-column">Còn được trả</th>
                        <th class="sale-number-column">Đơn giá gốc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in order.Lines)
                    {
                        <tr>
                            <td data-label="Mã sách" class="sale-book-id">@line.BookId</td>
                            <td data-label="Tên sách" class="sale-title">@(line.Title ?? "Không có tên")</td>
                            <td data-label="Đã mua" class="sale-number">@line.PurchasedQuantity.ToString("0.##########", CultureInfo.InvariantCulture)</td>
                            <td data-label="Đã trả" class="sale-number">@line.PreviouslyReturnedQuantity.ToString("0.##########", CultureInfo.InvariantCulture)</td>
                            <td data-label="Còn được trả" class="sale-number">@line.RemainingQuantity.ToString("0.##########", CultureInfo.InvariantCulture)</td>
                            <td data-label="Đơn giá gốc" class="sale-number">@(line.OriginalUnitPrice?.ToString("N4", CultureInfo.GetCultureInfo("vi-VN")) ?? "Không hợp lệ") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (order.CanReturn)
        {
            <a class="button return-primary-action" asp-controller="Returns" asp-action="Create" asp-route-orderId="@order.OrderId">Tạo phiếu trả sách</a>
        }
    </section>
}

<nav class="return-secondary-links" aria-label="Liên kết trả sách">
    <a asp-controller="Home" asp-action="Index">Quay lại trang chủ</a>
</nav>

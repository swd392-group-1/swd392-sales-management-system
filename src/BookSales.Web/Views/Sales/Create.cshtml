@using System.Globalization
@model ProcessSaleViewModel
@{
    ViewData["Title"] = "X\u1EED l\u00FD b\u00E1n h\u00E0ng";
    var vietnameseCulture = CultureInfo.GetCultureInfo("vi-VN");
}
<section class="page-heading sale-page-heading">
    <h1>T&#x1EA1;o &#x111;&#x1A1;n b&#xE1;n s&#xE1;ch</h1>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="field-hint" role="alert">@Model.Error</p>
}

<form asp-controller="Sales" asp-action="Create" method="post" class="panel sale-form" data-sale-form>
    @Html.AntiForgeryToken()
    <input asp-for="OrderId" type="hidden" />
    <div asp-validation-summary="All" role="alert"></div>
    <div class="sale-search-box">
        <label for="book-search">T&#xEC;m ki&#x1EBF;m s&#xE1;ch</label>
        <input type="text" id="book-search" class="sale-search-input" placeholder="Nh&#x1EAD;p t&#xEA;n s&#xE1;ch ho&#x1EB7;c m&#xE3; s&#xE1;ch c&#x1EA7;n t&#xEC;m..." autocomplete="off" />
    </div>
    <div id="book-list-empty" class="muted" hidden>Kh&#xF4;ng t&#xEC;m th&#x1EA5;y s&#xE1;ch ph&#xF9; h&#x1EE3;p.</div>
    @if (Model.Lines.Count == 0)
    {
        <p class="muted">Ch&#x1B0;a c&#xF3; s&#xE1;ch trong danh m&#x1EE5;c.</p>
    }
    else
    {
        <div class="sale-table-wrap" role="region" aria-label="Danh s&#xE1;ch s&#xE1;ch c&#xF3; th&#x1EC3; b&#xE1;n" tabindex="0">
            <table class="sale-table">
                <thead>
                    <tr>
                        <th scope="col" class="sale-book-column">M&#xE3; s&#xE1;ch</th>
                        <th scope="col" class="sale-title-column">T&#xEA;n s&#xE1;ch</th>
                        <th scope="col" class="sale-number-column">Gi&#xE1; b&#xE1;n</th>
                        <th scope="col" class="sale-number-column">T&#x1ED3;n kho</th>
                        <th scope="col" class="sale-quantity-column">S&#x1ED1; l&#x1B0;&#x1EE3;ng</th>
                    </tr>
                </thead>
                <tbody>
                @for (var index = 0; index < Model.Lines.Count; index++)
                {
                    var line = Model.Lines[index];
                    var book = Model.Books.FirstOrDefault(item => string.Equals(item.BookId, line.BookId, StringComparison.OrdinalIgnoreCase));
                    var unavailable = book is null || book.CurrentQuantity <= 0m || book.CurrentPrice is not > 0m;
                    var priceText = book?.CurrentPrice is > 0m
                        ? $"{book.CurrentPrice.Value.ToString("#,##0.####", vietnameseCulture)} \u20AB"
                        : "Ch\u01B0a c\u00F3 gi\u00E1 h\u1EE3p l\u1EC7";
                    <tr class="sale-row @(book is not null && book.CurrentQuantity <= 0m ? "is-out-of-stock" : null)"
                        data-price="@(book?.CurrentPrice?.ToString("F4", CultureInfo.InvariantCulture) ?? string.Empty)"
                        data-stock="@(book?.CurrentQuantity.ToString("F10", CultureInfo.InvariantCulture) ?? string.Empty)">
                        <td data-label="M&#xE3; s&#xE1;ch" class="sale-book-id">
                            <input asp-for="Lines[index].BookId" type="hidden" />
                            @line.BookId
                        </td>
                        <td data-label="T&#xEA;n s&#xE1;ch" class="sale-title">@(book?.Title ?? "Kh\u00F4ng t\u00ECm th\u1EA5y s\u00E1ch")</td>
                        <td data-label="Gi&#xE1; b&#xE1;n" class="sale-number">@priceText</td>
                        <td data-label="T&#x1ED3;n kho" class="sale-number">
                            @if (book is null)
                            {
                                <span>&#x2014;</span>
                            }
                            else if (book.CurrentQuantity <= 0m)
                            {
                                <span class="stock-badge stock-badge-empty">H&#x1EBF;t h&#xE0;ng</span>
                            }
                            else
                            {
                                <span>@book.CurrentQuantity.ToString("#,##0.##########", vietnameseCulture)</span>
                            }
                        </td>
                        <td data-label="S&#x1ED1; l&#x1B0;&#x1EE3;ng" class="sale-quantity-cell">
                            <input asp-for="Lines[index].Quantity" asp-format="{0:0}" class="sale-quantity" type="number" min="0" step="1" inputmode="numeric" aria-label="S&#x1ED1; l&#x1B0;&#x1EE3;ng @line.BookId" disabled="@unavailable" />
                            <span class="sale-row-error" role="alert" hidden></span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <fieldset class="sale-payment-methods">
        <legend>Ph&#x1B0;&#x1A1;ng th&#x1EE9;c thanh to&#xE1;n</legend>
        <label for="payment-method-cash"><input asp-for="PaymentMethod" type="radio" value="Cash" id="payment-method-cash" /> Ti&#x1EC1;n m&#x1EB7;t</label>
        <label for="payment-method-qr"><input asp-for="PaymentMethod" type="radio" value="QR" id="payment-method-qr" /> QR</label>
        <span asp-validation-for="PaymentMethod" class="field-hint"></span>
    </fieldset>

    <p id="sale-validation-message" class="field-hint sale-validation-message" role="alert" hidden></p>
    <section class="sale-total" aria-live="polite" aria-atomic="true">
        <div>
            <h2>T&#x1ED4;NG TI&#x1EC0;N</h2>
        </div>
        <output id="sale-total" class="sale-total-amount">0 &#x20AB;</output>
    </section>

    <button class="button sale-submit" type="submit" disabled="@(Model.Lines.Count == 0)">Ho&#xE0;n t&#x1EA5;t b&#xE1;n h&#xE0;ng</button>
</form>

@section Scripts {
    <script src="~/js/sales.js" asp-append-version="true"></script>
}

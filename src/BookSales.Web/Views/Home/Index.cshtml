@{
    ViewData["Title"] = "Tổng quan";
    var modules = new[]
    {
        ("01", "Danh mục và giá", "Thông tin sách, giá hiện tại và khuyến mãi.", "UC03 · UC10 · UC11"),
        ("02", "Mua hàng và tồn kho", "Đơn mua, nhận hàng, Count, Adjustment và Audit.", "UC04–09 · UC13–14"),
        ("03", "Bán hàng và trả sách", "Giao dịch tại quầy, QR và trả sách theo dòng bán.", "UC01 · UC02 · UC21"),
        ("04", "Truy cập và audit", "Tài khoản, quyền nhân viên, log và cảnh báo.", "UC12 · UC16–20"),
        ("05", "Báo cáo", "Xem và xuất báo cáo quản trị cửa hàng.", "UC15")
    };
}
<section class="hero">
    <p class="eyebrow">BOOK SALES MANAGEMENT SYSTEM</p>
    <h1>Quản lý nhà sách<br />trong cùng một nơi.</h1>
    <p class="intro">Chọn chức năng bán sách, trả sách, đổi giá, mua hàng, tồn kho hoặc báo cáo để bắt đầu.</p>
    <a class="button" href="/development">Kiểm tra async và realtime <span aria-hidden="true">→</span></a>
</section>
<section aria-labelledby="modules-title">
    <div class="section-heading"><h2 id="modules-title">Các chức năng</h2></div>
    <div class="module-grid">
    @foreach (var (number, title, description, cases) in modules)
    {
        @if (number == "03")
        {
            <article class="module-card module-card-sales">
                <span class="module-number">@number</span>
                <div class="module-function-list">
                    <a class="module-function-row" asp-controller="Sales" asp-action="Create">
                        <span class="module-function-copy">
                            <strong>Bán sách</strong>
                            <span>Tạo đơn hàng và thanh toán tiền mặt hoặc QR.</span>
                        </span>
                        <span class="module-function-arrow" aria-hidden="true">→</span>
                    </a>
                    <a class="module-function-row" asp-controller="Returns" asp-action="Search">
                        <span class="module-function-copy">
                            <strong>Trả sách</strong>
                            <span>Tìm đơn hàng và tạo phiếu trả sách.</span>
                        </span>
                        <span class="module-function-arrow" aria-hidden="true">→</span>
                    </a>
                </div>
            </article>
        }
        else
        {
            var href = number switch
            {
                "01" => "/Pricing",
                "02" => "/inventory",
                "04" => "/access/login",
                _ => "/reports/inventory"
            };
            <article class="module-card">
                <span class="module-number">@number</span>
                <h3><a href="@href">@title</a></h3><p>@description</p>
                <div class="card-meta"><a href="@href">Mở chức năng →</a></div>
            </article>
        }
    }
    </div>
</section>

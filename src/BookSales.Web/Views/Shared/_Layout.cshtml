@inject IWebHostEnvironment Environment
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · BookSales</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["ReceiptPage"] is true ? "receipt-page" : string.Empty)">
    <a class="skip-link" href="#main">Đến nội dung chính</a>
    <header class="site-header">
        <nav class="shell navigation" aria-label="Điều hướng chính">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">B</span> BookSales <span class="course">SWD392</span></a>
            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">Tổng quan</a>
                @if (Environment.IsDevelopment())
                {
                    <a href="/development">Kiểm tra kết nối</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/access/permissions">Quản lý quyền</a>
                    <a href="/access/logs">Nhật ký</a>
                    <a href="/access/demo">Demo quyền</a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a href="/access/login">Đăng nhập</a>
                }
            </div>
        <a href="/reports/inventory">Báo cáo tồn</a> <a href="/Pricing">Đổi giá</a></nav>
    </header>
    <main id="main" class="shell main-content">@RenderBody()</main>
    @if (ViewData["HideFooter"] is not true)
    {
        <footer class="shell site-footer">Book Sales Management System · Group 1 · Nền tảng phát triển .NET 8</footer>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
